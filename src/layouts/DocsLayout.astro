---
/**
 * 文档站框架：侧边栏 + 本页目录 + 上一页/下一页 + 移动端抽屉
 */
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { type Locale, localizedPath } from '../consts';

export interface DocItem {
  id: string;
  title: string;
  order: number;
  section: string;
}

interface Props {
  locale: Locale;
  title: string;
  description: string;
  items: DocItem[];
  currentId: string;
  headings: MarkdownHeading[];
  faq?: { q: string; a: string }[];
}

const { locale, title, description, items, currentId, headings, faq = [] } = Astro.props;

const grouped: { section: string; entries: DocItem[] }[] = [];
for (const item of [...items].sort((a, b) => a.order - b.order)) {
  let g = grouped.find((x) => x.section === item.section);
  if (!g) {
    g = { section: item.section, entries: [] };
    grouped.push(g);
  }
  g.entries.push(item);
}

const flat = [...items].sort((a, b) => a.order - b.order);
const idx = flat.findIndex((i) => i.id === currentId);
const prev = idx > 0 ? flat[idx - 1] : null;
const next = idx < flat.length - 1 ? flat[idx + 1] : null;

const docPath = (id: string) =>
  locale === 'en' ? `/en/docs/${id}` : `/docs/${id}`;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base locale={locale} title={`${title} · Mirrai 文档`} description={description} faq={faq}>
  <Header locale={locale} />
  <div class="mx-auto flex max-w-7xl gap-10 px-5 pb-24 pt-10 md:px-8">
    <!-- 移动端抽屉 -->
    <details class="hairline w-full rounded-xl border px-4 py-3 lg:hidden">
      <summary class="cursor-pointer text-[0.95rem] text-ink">{title}</summary>
      <nav class="mt-4 space-y-5">
        {
          grouped.map((g) => (
            <div>
              <div class="text-[0.75rem] tracking-[0.16em] text-ink-muted/70">{g.section}</div>
              <ul class="mt-2 space-y-1.5">
                {g.entries.map((e) => (
                  <li>
                    <a
                      href={docPath(e.id)}
                      class:list={[
                        'text-[0.9rem]',
                        e.id === currentId ? 'text-lamp-deep' : 'text-ink-muted',
                      ]}
                    >
                      {e.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </details>

    <!-- 侧边栏 -->
    <aside class="sticky top-24 hidden h-[calc(100vh-8rem)] w-56 shrink-0 overflow-y-auto lg:block">
      <nav class="space-y-6">
        {
          grouped.map((g) => (
            <div>
              <div class="text-[0.75rem] tracking-[0.16em] text-ink-muted/70">{g.section}</div>
              <ul class="mt-2.5 space-y-1.5">
                {g.entries.map((e) => (
                  <li>
                    <a
                      href={docPath(e.id)}
                      class:list={[
                        'block text-[0.9rem] leading-snug',
                        e.id === currentId
                          ? 'text-lamp-deep'
                          : 'text-ink-muted transition-colors hover:text-ink',
                      ]}
                    >
                      {e.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>

    <!-- 正文 -->
    <main class="min-w-0 flex-1">
      <article class="prose-garamond max-w-3xl text-ink-muted">
        <slot />
      </article>

      <!-- 上一页 / 下一页 -->
      <nav class="mt-16 flex flex-wrap gap-4">
        {
          prev && (
            <a
              href={docPath(prev.id)}
              class="hairline flex-1 rounded-xl border px-5 py-4 transition-colors hover:border-lamp-deep"
            >
              <div class="text-[0.75rem] tracking-[0.12em] text-ink-muted">←</div>
              <div class="mt-1 text-[0.95rem] text-ink">{prev.title}</div>
            </a>
          )
        }
        {
          next && (
            <a
              href={docPath(next.id)}
              class="hairline flex-1 rounded-xl border px-5 py-4 text-right transition-colors hover:border-lamp-deep"
            >
              <div class="text-[0.75rem] tracking-[0.12em] text-ink-muted">→</div>
              <div class="mt-1 text-[0.95rem] text-ink">{next.title}</div>
            </a>
          )
        }
      </nav>
    </main>

    <!-- 本页目录 -->
    {
      toc.length > 0 && (
        <aside class="sticky top-24 hidden h-[calc(100vh-8rem)] w-48 shrink-0 overflow-y-auto xl:block">
          <div class="text-[0.75rem] tracking-[0.16em] text-ink-muted/70">
            {locale === 'en' ? 'ON THIS PAGE' : '本页目录'}
          </div>
          <ul class="mt-3 space-y-2 text-[0.82rem]">
            {toc.map((h) => (
              <li class={h.depth === 3 ? 'pl-3' : ''}>
                <a href={`#${h.slug}`} class="text-ink-muted transition-colors hover:text-ink">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
  <Footer locale={locale} />
</Base>
