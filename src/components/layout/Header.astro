---
import Lockup from '../logo/Lockup.tsx';
import ThemeToggle from './ThemeToggle.astro';
import { useDict } from '../../i18n';
import { type Locale, localizedPath, REPO, USE_GITHUB_RELEASES_CTA } from '../../consts.ts';

interface Props {
  locale: Locale;
  /** 首页：页眉浮在照片场景（data-night-stage）上方，经过时透明、用夜色；属性值是场景底部渐隐的比例 */
  overlay?: boolean;
}

const { locale, overlay = false } = Astro.props;
const t = useDict(locale);

const anchors = [
  { href: '#how', label: t.nav.how },
  { href: '#graduation', label: t.nav.graduation },
  { href: '#trust', label: t.nav.trust },
  { href: '#download', label: t.nav.download },
];

const otherLocale: Locale = locale === 'en' ? 'zh' : 'en';
const langHref = localizedPath(Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/', otherLocale);
---

<header
  class:list={[
    'site-header top-0 z-40 border-b border-hairline bg-bg/88 backdrop-blur-md',
    overlay ? 'fixed inset-x-0' : 'sticky',
  ]}
  data-overlay={overlay ? '' : undefined}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 md:px-8">
    <a
      href={localizedPath('/', locale)}
      class="shrink-0 text-ink transition-opacity hover:opacity-85"
      aria-label="Mirrai"
    >
      <Lockup variant="horizontal" symbolSize={52} wordmarkSize={21} className="max-md:hidden" />
      <Lockup variant="horizontal" symbolSize={42} wordmarkSize={18} className="md:hidden" />
    </a>

    <nav class="hidden items-center gap-7 text-[0.925rem] text-ink-muted md:flex" aria-label={t.nav.menu}>
      {
        anchors.map((a) => (
          <a href={a.href} class="transition-colors hover:text-ink">
            {a.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-1.5">
      <a
        href={USE_GITHUB_RELEASES_CTA ? REPO.releases : REPO.url}
        target="_blank"
        rel="noopener"
        class="hairline inline-flex h-9 items-center gap-2 rounded-full border px-3 text-[0.85rem] text-ink-muted transition-colors hover:text-lamp-deep"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden>
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        <span class="max-lg:sr-only">GitHub</span>
      </a>
      <a
        href={langHref}
        class="hairline inline-flex h-9 items-center rounded-full border px-3 text-[0.85rem] text-ink-muted transition-colors hover:text-lamp-deep"
        hreflang={otherLocale === 'en' ? 'en' : 'zh-CN'}
      >
        {t.nav.lang}
      </a>
      <ThemeToggle label={t.nav.theme} />
    </div>
  </div>

  <!-- 移动端锚点导航：单行可滚动 -->
  <nav
    class="flex gap-5 overflow-x-auto border-t border-hairline px-5 py-2.5 text-[0.85rem] text-ink-muted md:hidden"
    aria-label={t.nav.menu}
  >
    {
      anchors.map((a) => (
        <a href={a.href} class="whitespace-nowrap transition-colors hover:text-ink">
          {a.label}
        </a>
      ))
    }
  </nav>
</header>

{
  overlay && (
    <script>
      const header = document.querySelector<HTMLElement>('.site-header[data-overlay]');
      if (header) {
        let ticking = false;
        const update = () => {
          ticking = false;
          const line = header.offsetHeight;
          const stages = Array.from(document.querySelectorAll<HTMLElement>('[data-night-stage]'));
          const over = stages.some((s) => {
            const r = s.getBoundingClientRect();
            const fade = parseFloat(s.dataset.nightStage ?? '') || 0;
            return r.top <= line && r.bottom - r.height * fade >= line;
          });
          header.classList.toggle('is-over-stage', over);
          if (over) header.setAttribute('data-theme', 'night');
          else header.removeAttribute('data-theme');
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update();
      }
    </script>
  )
}

<style>
  .site-header {
    transition:
      background-color 0.45s var(--ease-soft),
      border-color 0.45s var(--ease-soft),
      backdrop-filter 0.45s var(--ease-soft);
  }

  .site-header.is-over-stage {
    background-color: transparent;
    background-image: linear-gradient(to bottom, rgba(8, 7, 6, 0.6), rgba(8, 7, 6, 0));
    border-color: transparent;
    backdrop-filter: none;
  }

  .site-header.is-over-stage nav {
    border-color: transparent;
  }
</style>
