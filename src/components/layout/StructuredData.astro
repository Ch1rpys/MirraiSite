---
/**
 * 结构化数据（M3.3）：SoftwareApplication / WebSite / Organization
 */
import { SITE, REPO, GO_LINKS } from '../../consts';

interface Props {
  kind?: 'software' | 'website';
  faq?: { q: string; a: string }[];
}

const { kind = 'software', faq = [] } = Astro.props;

const software = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Mirrai',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'macOS, Windows, Docker, Linux',
  description:
    '开源情感记忆操作系统。上传聊天记录，重建 TA 的数字分身，用 TA 的语气说话，然后好好告别。',
  url: SITE.url,
  downloadUrl: `${SITE.url}/download`,
  softwareVersion: '1.3.0',
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: {
    '@type': 'Organization',
    name: 'Mirrai',
    url: SITE.url,
    sameAs: [REPO.url],
  },
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Mirrai',
  url: SITE.url,
  inLanguage: ['zh-CN', 'en'],
};

const faqSchema =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
---

<script type="application/ld+json" set:html={JSON.stringify(software)} />
<script type="application/ld+json" set:html={JSON.stringify(website)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
