---
/**
 * 截图槽位（P1–P8，见 EXECUTION.md §4.1 映射表）。
 * 摆拍成品按命名规范丢进 public/shots/ 后重新构建即自动上页；
 * 未就位时渲染占位卡（虚线 + 编号 + 场景说明），不会破版。
 * 文件规范：2x PNG，命名 shot-pNN-slug@2x.png；演示数据、无真实隐私。
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  /** P1 – P8 */
  id: 'P1' | 'P2' | 'P3' | 'P4' | 'P5' | 'P6' | 'P7' | 'P8';
  /** 场景说明（与摆拍清单一致） */
  scene: string;
  class?: string;
}

const { id, scene, class: className = '' } = Astro.props;

const slug: Record<string, string> = {
  P1: 'shot-p01-lobby@2x.png',
  P2: 'shot-p02-chat@2x.png',
  P3: 'shot-p03-upload@2x.png',
  P4: 'shot-p04-distill@2x.png',
  P5: 'shot-p05-farewell@2x.png',
  P6: 'shot-p06-letters@2x.png',
  P7: 'shot-p07-persona@2x.png',
  P8: 'shot-p08-privacy@2x.png',
};

const file = `/shots/${slug[id]}`;
const ready = existsSync(join(process.cwd(), 'public', 'shots', slug[id]));
---

{
  ready ? (
    <figure class={`shot-slot ${className}`}>
      <img src={file} alt={scene} loading="lazy" decoding="async" class="w-full rounded-2xl" />
      <figcaption class="mt-2 text-[0.75rem] tracking-[0.12em] text-ink-muted/70">
        {id} · {scene}
      </figcaption>
    </figure>
  ) : (
    <figure
      class={`hairline shot-slot flex min-h-[12rem] items-center justify-center rounded-2xl border border-dashed px-6 py-10 text-center ${className}`}
      data-shot-slot={id}
    >
      <figcaption class="text-[0.85rem] leading-relaxed tracking-[0.12em] text-ink-muted/70">
        <span class="font-display text-[1.25rem] text-ink-muted">{id}</span>
        <span class="mx-2 text-ink-muted/50">·</span>
        {scene}
        <span class="mt-1.5 block text-[0.75rem] text-ink-muted/50">
          待摆拍 · public/shots/{slug[id]}
        </span>
      </figcaption>
    </figure>
  )
}
