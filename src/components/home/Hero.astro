---
import Lockup from '../logo/Lockup.tsx';
import EntranceGaze from '../motion/EntranceGaze.astro';
import MessageTrace from '../motion/MessageTrace.astro';
import { useDict } from '../../i18n';
import { type Locale, REPO, USE_GITHUB_RELEASES_CTA } from '../../consts.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const trustItems = t.site.trust.split(' · ');
---

<section id="hero" class="relative overflow-hidden" aria-label="Hero">
  <div class="glow-lamp absolute inset-0" aria-hidden="true"></div>
  <div class="absolute right-[-6%] top-1/2 hidden w-[26rem] -translate-y-1/2 opacity-[0.16] lg:block" aria-hidden="true">
    <MessageTrace count={5} />
  </div>

  <div class="relative mx-auto flex min-h-[86vh] max-w-6xl flex-col justify-center px-5 pb-20 pt-16 md:px-8 md:pb-28 md:pt-24">
    <EntranceGaze>
      <Lockup variant="horizontal" symbolSize={104} wordmarkSize={38} className="gaze-word mb-10 text-ink" />
    </EntranceGaze>

    <h1 class="max-w-4xl whitespace-pre-line text-display text-ink">
      {t.hero.title}
    </h1>

    <p class="mt-7 max-w-2xl text-lede text-ink-muted">{t.hero.subtitle}</p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href={USE_GITHUB_RELEASES_CTA ? REPO.releases : '/download'}
        class="rounded-full bg-lamp px-7 py-3.5 text-[0.95rem] font-medium text-bg transition-opacity hover:opacity-88"
      >
        {t.hero.ctaPrimary}
      </a>
      <a
        href="#how"
        class="hairline rounded-full border px-7 py-3.5 text-[0.95rem] text-ink transition-colors hover:border-lamp-deep hover:text-lamp-deep"
      >
        {t.hero.ctaSecondary}
      </a>
      <span class="w-full text-[0.78rem] text-ink-muted/80 sm:w-auto">{t.hero.boundary}</span>
    </div>

    <div class="mt-14 flex flex-wrap gap-x-6 gap-y-2 text-[0.8rem] tracking-[0.12em] text-ink-muted">
      {
        trustItems.map((item) => (
          <span class="inline-flex items-center gap-2">
            <span class="inline-block h-1 w-1 rounded-full bg-lamp/80" aria-hidden="true" />
            {item}
          </span>
        ))
      }
    </div>
  </div>
</section>
