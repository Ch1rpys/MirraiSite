---
/**
 * 第二幕 · TA 不在的时候：四张不同的纸，错落地散在桌上——
 * 带火漆的信笺、撕下来的横线条、一张牛皮纸便签、一张写着三个时区的票根。
 */
import { useDict } from '../../i18n';
import type { Locale } from '../../consts.ts';
import ShotSlot from '../layout/ShotSlot.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const s = t.sections.absent;
const [letter, unreachable, pause, clock] = s.cards;

const zones = [
  { tz: 'UTC+8', time: '23:47' },
  { tz: 'UTC+0', time: '15:47' },
  { tz: 'UTC−5', time: '10:47' },
];
---

<section id="absent" class="py-24 md:py-36">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <div class="text-[0.8rem] tracking-[0.22em] text-lamp-deep">{s.kicker}</div>
      <h2 class="mt-4 text-headline text-ink">{s.title}</h2>
    </div>

    <div class="notes mt-16 md:mt-20">
      <div class="note note-letter paper-lift">
        <article class="paper px-7 pb-8 pt-7">
          <span class="seal" aria-hidden="true"></span>
          <h3 class="note-title">{letter.title}</h3>
          <p class="note-body">{letter.body}</p>
        </article>
      </div>

      <div class="note note-strip paper-lift">
        <article class="paper paper-white paper-lined paper-torn note-strip-paper">
          <h3 class="note-title">{unreachable.title}</h3>
          <p class="note-body">{unreachable.body}</p>
        </article>
      </div>

      <div class="note note-kraft paper-lift">
        <article class="paper paper-kraft px-6 py-6">
          <h3 class="note-title">{pause.title}</h3>
          <p class="note-body">{pause.body}</p>
        </article>
      </div>

      <div class="note note-ticket paper-lift">
        <article class="paper paper-card ticket">
          <div class="ticket-stub" aria-hidden="true">TIME</div>
          <div class="ticket-main">
            <h3 class="note-title">{clock.title}</h3>
            <p class="note-body">{clock.body}</p>
            <dl class="ticket-zones">
              {
                zones.map((z) => (
                  <div>
                    <dt>{z.tz}</dt>
                    <dd>{z.time}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </article>
      </div>

      <div class="note note-shot">
        <ShotSlot
          id="P6"
          scene={locale === 'en' ? 'Letters (write down / send)' : '信（写下来 / 交出去）'}
          locale={locale}
          tilt={3.2}
          tape
        />
      </div>
    </div>
  </div>
</section>

<style>
  .notes {
    display: grid;
    gap: 2.5rem;
  }

  .note {
    width: min(100%, 26rem);
  }

  .note:nth-child(even) {
    justify-self: end;
  }

  .note-title {
    font-family: var(--font-display);
    font-size: 1.22rem;
    line-height: 1.4;
    color: var(--paper-ink);
  }

  .note-body {
    margin-top: 0.7rem;
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--paper-ink-muted);
  }

  .note-letter {
    rotate: -2deg;
  }

  .seal {
    position: absolute;
    top: 1.1rem;
    right: 1.2rem;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #cf9356, #93592b 58%, #6a3e1c);
    box-shadow:
      inset 0 0 0 3px rgba(255, 230, 190, 0.12),
      inset 0 -2px 3px rgba(0, 0, 0, 0.3),
      0 1px 2px rgba(0, 0, 0, 0.35);
  }

  .note-strip {
    rotate: 1.4deg;
  }

  .note-strip-paper {
    --lines-top: 3.3rem;
    padding: 2.6rem 1.6rem 1.4rem calc(var(--margin-x) + 1rem);
  }

  .note-strip-paper .note-title,
  .note-strip-paper .note-body {
    line-height: var(--lh);
  }

  .note-strip-paper .note-body {
    margin-top: 0;
  }

  .note-kraft {
    width: min(100%, 18rem);
    rotate: 2.6deg;
  }

  .note-ticket {
    rotate: -1deg;
  }

  .ticket {
    --stub: 3.1rem;
    display: flex;
    mask:
      radial-gradient(circle at var(--stub) 0, transparent 0.5rem, #000 calc(0.5rem + 0.5px)) top / 100% 51% no-repeat,
      radial-gradient(circle at var(--stub) 100%, transparent 0.5rem, #000 calc(0.5rem + 0.5px)) bottom / 100% 51% no-repeat;
  }

  .ticket-stub {
    flex: 0 0 var(--stub);
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1.5px dashed rgba(42, 35, 28, 0.28);
    writing-mode: vertical-rl;
    font-size: 0.68rem;
    letter-spacing: 0.4em;
    color: var(--paper-pencil);
  }

  .ticket-main {
    flex: 1;
    padding: 1.5rem 1.6rem 1.5rem 1.4rem;
  }

  .ticket-zones {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(42, 35, 28, 0.14);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .ticket-zones div {
    display: flex;
    justify-content: space-between;
    color: var(--paper-ink-muted);
  }

  .ticket-zones div:first-child {
    color: var(--paper-ink);
  }

  .note-shot {
    width: min(78%, 19rem);
  }

  @media (min-width: 768px) {
    .notes {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
      row-gap: 0;
    }

    .note {
      width: auto;
      justify-self: stretch;
    }

    .note-letter {
      grid-column: 1 / 6;
    }

    .note-strip {
      grid-column: 7 / 13;
      margin-top: 3.5rem;
    }

    .note-kraft {
      grid-column: 2 / 5;
      margin-top: 1.5rem;
    }

    .note-ticket {
      grid-column: 6 / 11;
      margin-top: 4.5rem;
    }

    .note-shot {
      grid-column: 9 / 13;
      grid-row: 3;
      margin-top: -1rem;
    }
  }
</style>
