---
import { useDict } from '../../i18n';
import type { Locale } from '../../consts.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const s = t.sections.absent;
---

<section id="absent" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="max-w-2xl">
      <div class="text-[0.8rem] tracking-[0.22em] text-lamp-deep">{s.kicker}</div>
      <h2 class="mt-4 text-headline text-ink">{s.title}</h2>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        s.cards.map((card) => (
          <article class="hairline rounded-2xl border bg-surface/50 px-6 py-7">
            <h3 class="text-[1.08rem] font-medium text-ink">{card.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-[1.9] text-ink-muted">{card.body}</p>
          </article>
        ))
      }
    </div>

    <!-- 时间痕迹：时区排版 -->
    <div class="mt-12 flex flex-wrap gap-x-10 gap-y-4 text-[0.78rem] tracking-[0.16em] text-ink-muted" aria-hidden="true">
      <span>UTC+8　23:47</span>
      <span class="text-ink-muted/50">·</span>
      <span>UTC+0　15:47</span>
      <span class="text-ink-muted/50">·</span>
      <span>UTC−5　10:47</span>
    </div>
  </div>
</section>
