---
import { useDict } from '../../i18n';
import { type Locale, REPO, USE_GITHUB_RELEASES_CTA } from '../../consts.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const s = t.sections.download;

const href = (path: string) =>
  USE_GITHUB_RELEASES_CTA ? REPO.releases : locale === 'en' ? `/en${path}` : path;

const platforms = [
  { key: 'macos', label: s.platforms.macos, icon: '⌘', h: '/download' },
  { key: 'windows', label: s.platforms.windows, icon: '⊞', h: '/download' },
  { key: 'docker', label: s.platforms.docker, icon: '⬢', h: '/download' },
  { key: 'source', label: s.platforms.source, icon: '</>', h: REPO.url },
];
---

<section id="download" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="max-w-2xl">
      <div class="text-[0.8rem] tracking-[0.22em] text-lamp-deep">{s.kicker}</div>
      <h2 class="mt-4 text-headline text-ink">{s.title}</h2>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        platforms.map((p) => (
          <a
            href={p.key === 'source' ? p.h : href(p.h)}
            class="hairline group rounded-2xl border bg-surface/50 px-6 py-8 transition-colors hover:border-lamp-deep"
            {...(p.key === 'source' ? { target: '_blank', rel: 'noopener' } : {})}
          >
            <div class="text-[1.35rem] text-lamp" aria-hidden="true">
              {p.icon}
            </div>
            <div class="mt-4 text-[1.05rem] font-medium text-ink">{p.label}</div>
            <div class="mt-2 text-[0.85rem] text-ink-muted">{s.cta} →</div>
          </a>
        ))
      }
    </div>

    <p class="mt-8 text-[0.85rem] text-ink-muted">{s.requirement}</p>
    <p class="mt-2 text-[0.78rem] text-ink-muted/80">{s.boundary}</p>
  </div>
</section>
