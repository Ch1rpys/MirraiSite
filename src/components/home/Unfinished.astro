---
/**
 * 第一幕 · 未竟之言：就是桌上那封信。从 Hero 照片底部滑上来压住桌面；
 * 时间痕迹写在信里——停住的钟、没写完的结尾。
 */
import { useDict } from '../../i18n';
import type { Locale } from '../../consts.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const s = t.sections.unfinished;
---

<section id="unfinished" class="letter-section px-4 pb-24 sm:px-5 md:pb-36">
  <div class="letter-wrap paper-lift mx-auto max-w-[43rem]">
    <article class="paper paper-folds letter">
      <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <span class="text-[0.75rem] tracking-[0.22em] ink-pencil">{s.kicker}</span>
        <span class="inline-flex items-center gap-2 text-[0.8rem] tracking-[0.08em] ink-pencil">
          <svg class="letter-clock" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
            <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
            <line x1="12" y1="12" x2="12" y2="6.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" transform="rotate(353.5 12 12)"></line>
            <line x1="12" y1="12" x2="12" y2="4.2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" transform="rotate(282 12 12)"></line>
          </svg>
          {s.letter.date}
        </span>
      </header>

      <h2 class="letter-title mt-9">{s.title}</h2>
      <p class="letter-body mt-6">{s.body}</p>

      <figure class="mt-10">
        <blockquote class="letter-quote">「{s.quote}」</blockquote>
        <figcaption class="mt-3 text-[0.8rem] tracking-[0.14em] ink-pencil">
          —— <a class="letter-link" href={locale === 'en' ? '/en/about' : '/about'}>{s.quoteFrom}</a>
        </figcaption>
      </figure>

      <p class="letter-ending mt-14">
        {s.letter.ending}<span class="letter-caret" aria-hidden="true"></span>
      </p>
      <p class="mt-2 text-[0.72rem] tracking-[0.2em] ink-pencil">{s.letter.endingLabel}</p>
    </article>
  </div>
</section>

<style>
  .letter-section {
    padding-top: 12svh;
  }

  .letter-wrap {
    transform: rotate(-0.7deg);
  }

  .letter {
    padding: clamp(2rem, 6vw, 4rem) clamp(1.5rem, 6vw, 4.25rem) clamp(2.25rem, 6vw, 3.75rem);
  }

  .letter-title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    line-height: 1.3;
    color: var(--paper-ink);
  }

  .letter-body {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 2;
    color: var(--paper-ink-muted);
  }

  .letter-quote {
    padding-left: 1.25rem;
    border-left: 2px solid rgba(168, 112, 58, 0.55);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.8;
    color: var(--paper-ink);
  }

  .letter-link {
    color: var(--paper-ink-muted);
    text-decoration: underline;
    text-decoration-color: rgba(42, 35, 28, 0.25);
  }

  .letter-link:hover {
    color: #8f5a2e;
  }

  .letter-ending {
    font-family: var(--font-body);
    font-size: 1.1rem;
    color: var(--paper-ink);
  }

  .letter-caret {
    display: inline-block;
    width: 1.5px;
    height: 1.15em;
    margin-left: 0.2em;
    vertical-align: -0.2em;
    background: var(--paper-ink);
    animation: letter-caret 1.15s steps(1) infinite;
  }

  @keyframes letter-caret {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .letter-caret {
      animation: none;
    }
  }
</style>
