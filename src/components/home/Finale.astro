---
/**
 * 第三幕 · 掩卷：一个连续的场景，不是三屏。
 * 镜头退回房间远景（灯亮）→ 灯旁小字：信任（原 S7）→ 桌上的信封：下载（原 S8）
 * → 灯灭，黑暗里浮出尾句（原 S9，全站只出现这一次）。
 * 有 JS 且未要求减动效时，舞台钉在视口里随滚动推进（.is-live），这时才算页眉要透明的夜景舞台；
 * 否则按顺序平铺，灯灭用两张静帧表达。
 */
import { getImage } from 'astro:assets';
import roomWide from '../../assets/room/room-wide.jpg';
import roomWideP from '../../assets/room/room-wide-p.jpg';
import roomDark from '../../assets/room/room-dark.jpg';
import roomDarkP from '../../assets/room/room-dark-p.jpg';
import { fresh } from '../room/fresh';
import ScenePicture from '../room/ScenePicture.astro';
import { coverVars } from '../room/scene';
import { useDict } from '../../i18n';
import { type Locale, REPO, USE_GITHUB_RELEASES_CTA } from '../../consts.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const trust = t.sections.trust;
const dl = t.sections.download;
const coda = t.sections.coda;
const path = (p: string) => (locale === 'en' ? `/en${p}` : p);
const downloadHref = USE_GITHUB_RELEASES_CTA ? REPO.releases : path('/download');
const darkStill = await getImage({ src: roomDark, format: 'webp', width: 1280, quality: 70 });
---

<section id="finale" class="finale" data-theme="night" style={`--dark-still:url(${fresh(roomDark)(darkStill.src)})`}>
  <span id="trust" class="finale-anchor" style="top:28%"></span>
  <span id="download" class="finale-anchor" style="top:56%"></span>

  <div class="finale-stage">
    <div class="scene room-scene finale-scene" aria-hidden="true">
      <!-- 灯亮 / 灯灭两张出自同一机位，逐像素对得上；镜头绕着灯往回退 -->
      <div class="scene-cover finale-cover" style={coverVars('wide')}>
        <ScenePicture l={roomWide} p={roomWideP} class="finale-on" />
        <ScenePicture l={roomDark} p={roomDarkP} class="finale-off" />
        <span class="scene-lamp finale-lamp"></span>
      </div>
      <div class="finale-shade"></div>
      <div class="finale-hush"></div>
      <div class="scene-grain"></div>
    </div>

    <div class="finale-beats">
      <div class="beat beat-trust">
        <div class="text-[0.75rem] tracking-[0.22em] text-lamp">{trust.kicker}</div>
        <h2 class="mt-3 font-display text-[1.55rem] leading-snug text-ink md:text-[1.8rem]">{trust.title}</h2>
        <ul class="mt-6 space-y-3.5">
          {
            trust.points.map((p) => (
              <li class="text-[0.86rem] leading-[1.75]">
                <span class="text-ink">{p.title}</span>
                <span class="text-ink-muted">{locale === 'en' ? ' — ' : ' —— '}{p.body}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2">
          {
            !USE_GITHUB_RELEASES_CTA && (
              <a href={path('/ethics')} class="link-quiet text-[0.85rem]">
                {trust.cta} →
              </a>
            )
          }
          <span class="text-[0.75rem] text-ink-muted/80">{t.hero.boundary}</span>
        </div>
      </div>

      <div class="beat beat-envelope">
        <a href={downloadHref} class="envelope-link">
          <span class="envelope-lift paper-lift">
            <span class="paper envelope">
              <span class="env-stamp" aria-hidden="true">
                <span>{dl.platforms.macos}</span>
                <span>{dl.platforms.windows}</span>
                <span>{dl.platforms.docker}</span>
              </span>
              <span class="env-postmark" aria-hidden="true"></span>
              <span class="env-address">
                <span class="env-kicker">{dl.kicker}</span>
                <span class="env-title">{dl.title}</span>
                <span class="env-cta">{dl.cta} <span class="env-arrow">→</span></span>
              </span>
            </span>
          </span>
        </a>
        <p class="mt-6 text-center text-[0.78rem] leading-relaxed text-ink-muted">{dl.requirement}</p>
        <p class="mt-1.5 text-center text-[0.74rem] text-ink-muted/75">
          <a href={REPO.url} target="_blank" rel="noopener" class="link-quiet">{dl.platforms.source} →</a>
          <span class="mx-2 text-ink-muted/50">·</span>
          {dl.boundary}
        </p>
      </div>

      <div class="beat beat-coda">
        <div class="text-[0.75rem] tracking-[0.22em] text-ink-muted/70">{coda.kicker}</div>
        <h2 class="coda-title mx-auto mt-6 max-w-4xl whitespace-pre-line text-display text-ink">{coda.title}</h2>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-[0.92rem]">
          <a href={REPO.url} target="_blank" rel="noopener" class="link-quiet">{coda.links.github}</a>
          {
            !USE_GITHUB_RELEASES_CTA && (
              <>
                <a href={path('/about')} class="link-quiet">
                  {coda.links.handnotes}
                </a>
                <a href={path('/blog')} class="link-quiet">
                  {coda.links.blog}
                </a>
              </>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.finale');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce) {
    root.classList.add('is-live');
    root.dataset.nightStage = '';
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = root.getBoundingClientRect();
      const vh = window.innerHeight;
      const total = Math.max(1, r.height - vh);
      const p = Math.min(1, Math.max(0, -r.top / total));
      const enter = Math.min(1, Math.max(0, 1 - r.top / vh));
      root.style.setProperty('--p', p.toFixed(4));
      root.style.setProperty('--enter', enter.toFixed(4));
      const beat = p < 0.1 ? 'room' : p < 0.4 ? 'trust' : p < 0.68 ? 'envelope' : 'coda';
      if (root.dataset.beat !== beat) root.dataset.beat = beat;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>

<style>
  .finale {
    position: relative;
    background: #0b0a09;
  }

  .finale-anchor {
    position: absolute;
    left: 0;
    width: 1px;
    height: 1px;
  }

  /* ---------- 平铺（无 JS / 减动效） ---------- */
  .finale-stage {
    position: relative;
  }

  .finale:not(.is-live) .finale-scene {
    position: relative;
    height: 72svh;
  }

  .finale:not(.is-live) :global(.finale-off) {
    opacity: 0;
  }

  .finale:not(.is-live) .beat {
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem 1.25rem;
  }

  /* 尾句的第一行连同破折号要在手机上放得下一行，否则「——」会单独掉到下一行 */
  .coda-title {
    font-size: min(var(--text-display), calc((100vw - 2.5rem) / 11.2));
  }

  .finale:not(.is-live) .beat-coda {
    max-width: none;
    padding: 30svh 1.25rem;
    text-align: center;
    background:
      linear-gradient(to bottom, #0b0a09, rgba(11, 10, 9, 0.35) 30%, rgba(11, 10, 9, 0.35) 70%, #0b0a09),
      var(--dark-still) center / cover no-repeat;
  }

  /* ---------- 随滚动推进 ---------- */
  .finale.is-live {
    --p: 0;
    --enter: 0;
    height: 430svh;
  }

  .finale.is-live .finale-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .finale.is-live .finale-scene {
    opacity: calc(0.12 + 0.88 * var(--enter));
  }

  /* 往回退的镜头绕着灯转（灯在静帧里的位置来自 scene.json） */
  .finale-cover {
    --ox: var(--lx);
    --oy: calc(var(--ly) + 0.08);
  }

  .finale.is-live .finale-cover {
    transform: scale(calc(1.3 - 0.3 * min(1, var(--p) * 7)));
  }

  .finale :global(.finale-off) {
    opacity: 0;
    transition: opacity 0.5s ease-in;
  }

  .finale.is-live[data-beat='coda'] :global(.finale-off) {
    opacity: 1;
  }

  .finale.is-live[data-beat='coda'] .finale-lamp {
    opacity: 0;
    animation: none;
  }

  .finale-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, #0b0a09 0%, rgba(11, 10, 9, 0) 16%, rgba(11, 10, 9, 0) 78%, rgba(11, 10, 9, 0.85) 100%),
      linear-gradient(90deg, rgba(8, 7, 6, 0.86) 0%, rgba(8, 7, 6, 0.4) 36%, rgba(8, 7, 6, 0) 60%);
    transition: background 0.8s;
  }

  /* 灯灭之后，尾句背后再暗一层 */
  .finale-hush {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(ellipse 55% 45% at 50% 50%, rgba(6, 5, 4, 0.78), transparent 75%);
    transition: opacity 1.2s ease 0.4s;
  }

  .finale.is-live[data-beat='coda'] .finale-hush {
    opacity: 1;
  }

  .finale.is-live .finale-beats {
    position: absolute;
    inset: 0;
  }

  .finale.is-live .beat {
    position: absolute;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 0.7s ease,
      transform 0.9s var(--ease-soft),
      visibility 0s linear 0.7s;
  }

  .finale.is-live[data-beat='trust'] .beat-trust,
  .finale.is-live[data-beat='envelope'] .beat-envelope,
  .finale.is-live[data-beat='coda'] .beat-coda {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.9s ease 0.15s,
      transform 1.1s var(--ease-soft) 0.15s,
      visibility 0s;
  }

  .finale.is-live[data-beat='coda'] .beat-coda {
    transition-delay: 1s;
  }

  .finale.is-live .beat-trust {
    top: 50%;
    left: max(1.5rem, 7vw);
    width: min(26rem, calc(100vw - 3rem));
    translate: 0 -50%;
  }

  .finale.is-live .beat-envelope {
    left: 50%;
    bottom: 7svh;
    width: min(27rem, calc(100vw - 2.5rem));
    translate: -50% 0;
  }

  .finale.is-live .beat-coda {
    top: 50%;
    left: 50%;
    width: min(56rem, calc(100vw - 2.5rem));
    translate: -50% -50%;
    text-align: center;
  }

  @media (max-aspect-ratio: 1/1) {
    .finale.is-live .beat-trust {
      top: auto;
      bottom: 5svh;
      left: 1.25rem;
      translate: none;
    }

    .finale-shade {
      background:
        linear-gradient(to bottom, #0b0a09 0%, rgba(11, 10, 9, 0) 14%, rgba(11, 10, 9, 0) 34%, rgba(8, 7, 6, 0.9) 62%, #0b0a09 100%);
    }
  }

  /* ---------- 信封 ---------- */
  .envelope-link {
    display: block;
    text-decoration: none;
  }

  .envelope-lift {
    display: block;
    rotate: -2deg;
    transition:
      rotate 0.5s var(--ease-soft),
      translate 0.5s var(--ease-soft),
      filter 0.5s var(--ease-soft);
  }

  .envelope-link:hover .envelope-lift,
  .envelope-link:focus-visible .envelope-lift {
    rotate: -0.5deg;
    translate: 0 -6px;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.5)) drop-shadow(0 30px 30px rgba(0, 0, 0, 0.6));
  }

  .envelope {
    display: block;
    aspect-ratio: 1.6;
    box-shadow:
      inset 0 0 0 1px rgba(80, 56, 30, 0.12),
      inset 0 -18px 30px -24px rgba(60, 40, 20, 0.35);
  }

  .env-stamp {
    position: absolute;
    top: 9%;
    right: 6%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    width: 18%;
    aspect-ratio: 0.82;
    padding: 0.3rem;
    background: #a8693a;
    color: #f4e6cf;
    font-size: clamp(0.5rem, 1.6vw, 0.62rem);
    letter-spacing: 0.06em;
    line-height: 1.35;
    mask:
      radial-gradient(circle at 50% 50%, #000 62%, transparent 64%) 0 0 / 0.42rem 0.42rem round,
      linear-gradient(#000, #000) center / calc(100% - 0.42rem) calc(100% - 0.42rem) no-repeat;
  }

  /* 邮戳：一圈细线 + 向左延伸的几道波纹 */
  .env-postmark {
    position: absolute;
    top: 10%;
    right: 20%;
    width: 15%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(70, 52, 34, 0.32);
    rotate: -10deg;
  }

  .env-postmark::after {
    content: '';
    position: absolute;
    top: 30%;
    right: 92%;
    width: 140%;
    height: 40%;
    background: repeating-linear-gradient(
      to bottom,
      rgba(70, 52, 34, 0.26) 0 1px,
      transparent 1px 6px
    );
    mask: linear-gradient(to left, #000 40%, transparent);
  }

  .env-address {
    position: absolute;
    left: 10%;
    right: 12%;
    bottom: 13%;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .env-kicker {
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    color: var(--paper-pencil);
  }

  .env-title {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(42, 35, 28, 0.2);
    font-family: var(--font-display);
    font-size: clamp(1rem, 3.6vw, 1.3rem);
    line-height: 1.45;
    color: var(--paper-ink);
  }

  .env-cta {
    font-size: 0.86rem;
    letter-spacing: 0.08em;
    color: #8f5a2e;
  }

  .env-arrow {
    display: inline-block;
    transition: translate 0.35s var(--ease-soft);
  }

  .envelope-link:hover .env-arrow {
    translate: 4px 0;
  }
</style>
