---
import { useDict } from '../../i18n';
import type { Locale } from '../../consts.ts';
import ShotSlot from '../layout/ShotSlot.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const s = t.sections.how;
---

<section id="how" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="max-w-2xl">
      <div class="text-[0.8rem] tracking-[0.22em] text-lamp-deep">{s.kicker}</div>
      <h2 class="mt-4 text-headline text-ink">{s.title}</h2>
    </div>

    <ShotSlot id="P1" scene={locale === 'en' ? 'Lobby (multiple personas)' : '大厅（多分身）'} class="mt-12" />

    <ol class="mt-12 grid gap-10 md:grid-cols-3">
      {
        s.steps.map((step, i) => (
          <li class="relative">
            <div class="font-display text-[2.1rem] leading-none text-lamp/85">{step.n}</div>
            <h3 class="mt-4 text-[1.12rem] font-medium text-ink">{step.title}</h3>
            <p class="mt-3 text-[0.95rem] leading-[1.9] text-ink-muted">{step.body}</p>
            <ShotSlot
              id={i === 0 ? 'P3' : i === 1 ? 'P4' : 'P2'}
              scene={
                i === 0
                  ? locale === 'en'
                    ? 'Upload materials'
                    : '上传素材页'
                  : i === 1
                    ? locale === 'en'
                      ? 'Distillation progress'
                      : '蒸馏进度'
                    : locale === 'en'
                      ? 'Conversation'
                      : '对话界面'
              }
              class="mt-5"
            />
          </li>
        ))
      }
    </ol>

    <p class="mt-14 max-w-2xl border-l-2 border-lamp/60 pl-6 font-display text-[1.3rem] leading-relaxed text-ink">
      {s.hardline}
    </p>


  </div>
</section>
