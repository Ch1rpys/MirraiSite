---
import { useDict } from '../../i18n';
import { type Locale, USE_GITHUB_RELEASES_CTA } from '../../consts.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const s = t.sections.trust;
---

<section id="trust" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="max-w-2xl">
      <div class="text-[0.8rem] tracking-[0.22em] text-lamp-deep">{s.kicker}</div>
      <h2 class="mt-4 text-headline text-ink">{s.title}</h2>
    </div>

    <div class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {
        s.points.map((p) => (
          <div>
            <h3 class="text-[1.05rem] font-medium text-ink">{p.title}</h3>
            <p class="mt-2.5 text-[0.95rem] leading-[1.9] text-ink-muted">{p.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-3">
      {
        !USE_GITHUB_RELEASES_CTA && (
          <a
            href={locale === 'en' ? '/en/ethics' : '/ethics'}
            class="link-quiet text-[0.95rem]"
          >
            {s.cta} →
          </a>
        )
      }
      <span class="text-[0.78rem] text-ink-muted/80">{t.hero.boundary}</span>
    </div>
  </div>
</section>
