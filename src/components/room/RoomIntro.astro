---
/**
 * 进门镜头：夜里的房间 → 走向书桌 → 溶进 Hero（书桌近景）。
 *
 * 两层，同一条时间轴、同一个跳过键（时间轴在 Base.astro 的 head 脚本里）：
 *  - 三维层（room3d.ts）：Blender 里搭的这间房，镜头真的走进去，落点与 Hero 照片是同一个机位。
 *  - 2.5D 退路：三维层用不了（不支持 WebGL2 / 省流量 / 超时没加载完）时，把远景照片推近再溶过去。
 * 开场先显示远景静帧（也是三维层的第一帧），所以谁接手都不跳。
 * 减少动效 / 带锚点进入时不播；没有 JS 时整层不出现，正文始终在 DOM 里。
 */
import ScenePicture from './ScenePicture.astro';
import roomWide from '../../assets/room/room-wide.jpg';
import roomWideP from '../../assets/room/room-wide-p.jpg';
import { coverVars, pushVars } from './scene';
import { useDict } from '../../i18n';
import type { Locale } from '../../consts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
---

<div class="room-intro" role="presentation">
  <div class="scene room-scene">
    <div class="scene-cover intro-cover" style={`${coverVars('wide')};${pushVars()}`}>
      <ScenePicture l={roomWide} p={roomWideP} eager />
      <span class="scene-lamp"></span>
    </div>
    <canvas class="intro-canvas" aria-hidden="true"></canvas>
    <div class="intro-vignette"></div>
    <div class="scene-grain"></div>
  </div>
  <button type="button" class="intro-skip-btn">{t.intro.skip}</button>
</div>

<script>
  import { startRoom3D } from './room3d';
  startRoom3D();
</script>

<style is:global>
  .room-intro {
    display: none;
  }

  /* 时间由 Base.astro 的 head 脚本写到 <html> 上；这里是没写上时的默认值 */
  html.intro-run {
    --intro-push-dur: 3.45s;
    --intro-out-at: 2.55s;
    --intro-out-dur: 0.9s;
    --intro-copy-at: 3s;
    --gaze-delay: var(--intro-copy-at);
  }

  html.intro-run:not(.intro-skip):not(.intro-done) {
    overflow: hidden;
  }

  html.intro-run .room-intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 60;
    background: #0b0a09;
    cursor: pointer;
    animation: intro-out var(--intro-out-dur) cubic-bezier(0.45, 0, 0.2, 1) var(--intro-out-at) forwards;
  }

  html.intro-run.intro-skip .room-intro {
    animation: intro-skip-out 0.45s ease forwards;
  }

  html.intro-done .room-intro {
    display: none;
  }

  /* 2.5D 推镜：远景绕灯与信所在的点放大，尽量对上近景 */
  .intro-cover {
    --push: var(--push-l, 2.9);
    --ox: var(--ox-l, 0.6);
    --oy: var(--oy-l, 0.6);
    animation: intro-push var(--intro-push-dur) cubic-bezier(0.42, 0.04, 0.2, 1) both;
  }

  @media (max-aspect-ratio: 1/1) {
    .intro-cover {
      --push: var(--push-p, 2.5);
      --ox: var(--ox-p, 0.6);
      --oy: var(--oy-p, 0.6);
    }
  }

  /* 三维层：盖在远景静帧上，镜头由 room3d.ts 驱动 */
  .intro-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  html.intro-3d .intro-canvas {
    opacity: 1;
  }

  html.intro-3d .intro-cover {
    animation: none;
  }

  /* 开灯：静帧和三维层一起从暗处亮起来 */
  .intro-cover picture,
  .intro-canvas {
    animation: intro-lights 1.3s ease-out both;
  }

  /* 停一拍 / 等三维层的时候，时间轴先不走 */
  html.intro-hold .room-intro,
  html.intro-hold .intro-cover,
  html.intro-hold .hero-reveal,
  html.intro-hold .site-header,
  html.intro-hold .entrance-gaze :is(.gaze-left, .gaze-right, .gaze-axis, .gaze-word) {
    animation-play-state: paused;
  }

  .intro-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 75% 70% at 62% 55%, transparent 40%, rgba(6, 5, 4, 0.72) 100%);
  }

  /* 按钮的类名不能叫 intro-skip：那是跳过时加在 <html> 上的状态类，这里又是全局样式，会整套落到根元素上 */
  .intro-skip-btn {
    position: absolute;
    right: max(1.25rem, env(safe-area-inset-right));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 2;
    padding: 0.55rem 1.1rem;
    border: 1px solid rgba(242, 237, 228, 0.22);
    border-radius: 999px;
    background: rgba(12, 10, 9, 0.4);
    color: rgba(242, 237, 228, 0.82);
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    backdrop-filter: blur(6px);
    transition:
      color 0.25s,
      border-color 0.25s;
  }

  .intro-skip-btn:hover,
  .intro-skip-btn:focus-visible {
    color: #e4a868;
    border-color: rgba(228, 168, 104, 0.6);
  }

  /* Hero 文字与页眉：在镜头落定后浮现；跳过时立刻出现 */
  html.intro-run .hero-reveal,
  html.intro-run .site-header {
    animation: hero-reveal 1.1s cubic-bezier(0.22, 0.61, 0.36, 1)
      calc(var(--intro-copy-at) + var(--i, 0) * 0.14s) both;
  }

  html.intro-run.intro-skip .hero-reveal,
  html.intro-run.intro-skip .site-header {
    animation-delay: calc(var(--i, 0) * 0.06s);
    animation-duration: 0.6s;
  }

  html.intro-run.intro-skip {
    --gaze-delay: 0s;
  }

  @keyframes intro-push {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(var(--push));
    }
  }

  @keyframes intro-lights {
    from {
      filter: brightness(0.12);
    }
    to {
      filter: none;
    }
  }

  @keyframes intro-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @keyframes intro-skip-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
