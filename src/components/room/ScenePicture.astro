---
/**
 * 一张场景静帧，横、竖各一幅构图（同一段镜头的两种取景），由视口方向决定用哪幅。
 * 放在 `.scene-cover` 里，由它负责铺满和对准。
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { fresh } from './fresh';
import { PORTRAIT } from './scene';

interface Props {
  /** 横幅（16:9） */
  l: ImageMetadata;
  /** 竖幅（3:4） */
  p: ImageMetadata;
  /** 首屏就要用：不懒加载、高优先级 */
  eager?: boolean;
  class?: string;
}
const { l, p, eager = false, class: className } = Astro.props;

const L_WIDTHS = [640, 960, 1280, 1920, 2560];
const P_WIDTHS = [480, 720, 1080, 1440];
const [lAvif, lWebp, pAvif, pWebp, fallback] = await Promise.all([
  getImage({ src: l, widths: L_WIDTHS, format: 'avif' }),
  getImage({ src: l, widths: L_WIDTHS, format: 'webp' }),
  getImage({ src: p, widths: P_WIDTHS, format: 'avif' }),
  getImage({ src: p, widths: P_WIDTHS, format: 'webp' }),
  getImage({ src: l, width: 1280, format: 'jpg' }),
]);
// 开发服务器下给地址带上文件修改时间（见 fresh.ts）；正式构建原样返回
const freshL = fresh(l);
const freshP = fresh(p);
// 图片盒子按「铺满」算宽：视口比画幅更扁时取视口宽，否则按视口高换算
const L_SIZES = '(max-aspect-ratio: 16/9) 177.78vh, 100vw';
const P_SIZES = '(max-aspect-ratio: 3/4) 75vh, 100vw';
---

<picture class={className}>
  <source media={PORTRAIT} type="image/avif" srcset={freshP(pAvif.srcSet.attribute)} sizes={P_SIZES} />
  <source media={PORTRAIT} type="image/webp" srcset={freshP(pWebp.srcSet.attribute)} sizes={P_SIZES} />
  <source type="image/avif" srcset={freshL(lAvif.srcSet.attribute)} sizes={L_SIZES} />
  <source type="image/webp" srcset={freshL(lWebp.srcSet.attribute)} sizes={L_SIZES} />
  <img
    src={freshL(fallback.src)}
    alt=""
    width={l.width}
    height={l.height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
</picture>
