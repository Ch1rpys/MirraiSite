---
/**
 * /en/ethics — Ethics & boundaries (M2.2)
 * All five "not" items kept; privacy is not expanded here, only linked to /en/privacy.
 * Local help resources are internationalized (Befrienders Worldwide / findahelpline.com).
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

const locale = 'en' as const;

const nots = [
  {
    title: 'Not a replacement',
    body: "Mirrai is not a substitute for real relationships. It is a space to help you finish saying what was left unsaid — not a place to stay forever. The graduation mechanism exists precisely so this experience has an ending.",
  },
  {
    title: 'Not a win-them-back tool',
    body: "It is not here to teach you how to reunite. It does not do relationship counseling, and it does not give advice on \"how to get her back\". It does one thing only: keep going until what was left unsaid is said.",
  },
  {
    title: 'Consent comes first',
    body: "Modeling the persona of a real person should be done with their consent beforehand. Only upload records you have the right to use. If they have not given their consent, please do not use their records to create a replica.",
  },
  {
    title: 'Boundaries of professional help',
    body: "Mirrai cannot replace professional counseling. If you are going through severe emotional distress, please seek professional help (see the resources below). It is a mirror, not a doctor.",
  },
  {
    title: 'Transparent AI identity',
    body: "This is a simulation, not them. In the default configuration, the replica will admit it is an AI when asked seriously (this can be adjusted in settings). We put this in the most visible place — not buried in the terms.",
  },
];

const layers = [
  {
    title: 'Data stays local',
    body: 'Uploaded materials are saved on your own machine (./uploads/). From upload to distillation to conversation, nothing passes through any third-party server. Paired with Ollama, fully offline inference is possible.',
  },
  {
    title: 'Memory anchors against hallucination',
    body: 'Every reply is annotated with which memories it recalled. When it mentions something from three months ago, that was retrieved, not invented. Memory and generation are separated — traceable and auditable.',
  },
  {
    title: 'Emotional safety layer',
    body: "Built-in crisis detection, plus monitoring of usage intensity and dependency trends. It does not analyze you and it does not upload you — it only gives you a single nudge when you are going deeper and deeper.",
  },
  {
    title: 'Graduation suggests only once',
    body: 'By default, the graduation mechanism only suggests: after bringing it up once, it enters a cooldown, and will only mention it again after the cooldown passes. Declining is not a closed door — you can change your mind at any time. You can set it to "manual only" or "off"; the final decision is in your hands.',
  },
  {
    title: 'Open source, auditable',
    body: "MIT licensed. Distillation, memory, emotional state, responses — every layer of code you can read and change yourself. We do not ask you to trust us. We ask you to audit us.",
  },
];

const helps = [
  { name: 'Befrienders Worldwide', contact: 'befrienders.org' },
  { name: 'Find a local crisis line near you', contact: 'findahelpline.com' },
];
---

<Base
  locale={locale}
  title="Ethics & boundaries · Mirrai"
  description="Mirrai is not a replacement, not a win-them-back tool, consent comes first, it cannot replace professional help, and its AI identity is transparent. Data stays local, memory anchors against hallucination, an emotional safety layer, graduation suggests only once, open source and auditable."
>
  <Header locale={locale} />
  <main class="mx-auto max-w-3xl px-5 pb-24 pt-16 md:px-8 md:pt-24">
    <div class="text-[0.8rem] tracking-[0.22em] text-lamp-deep">Ethics &amp; boundaries</div>
    <h1 class="mt-4 text-headline text-ink">This product deals with real people and real feelings.</h1>
    <p class="mt-6 text-lede text-ink-muted">
      Please read this before you use Mirrai. The five points below are not disclaimers — they are the design premises of the product.
    </p>

    <!-- Five "not" items -->
    <section class="mt-14 space-y-10">
      {
        nots.map((n, i) => (
          <article>
            <div class="flex items-baseline gap-4">
              <span class="font-display text-[1.6rem] text-lamp/85">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="text-[1.25rem] font-medium text-ink">{n.title}</h2>
            </div>
            <p class="prose-garamond mt-3 text-ink-muted">{n.body}</p>
          </article>
        ))
      }
    </section>

    <!-- Five mechanism layers -->
    <section class="mt-16">
      <h2 class="text-[1.35rem] font-medium text-ink">Five more things we built into it</h2>
      <div class="mt-8 space-y-8">
        {
          layers.map((l) => (
            <div class="hairline rounded-2xl border bg-surface/40 px-6 py-6">
              <h3 class="text-[1.05rem] font-medium text-ink">{l.title}</h3>
              <p class="mt-2.5 text-[0.95rem] leading-[1.9] text-ink-muted">{l.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Help resources -->
    <section class="mt-16">
      <h2 class="text-[1.35rem] font-medium text-ink">If you are going through severe emotional distress</h2>
      <p class="mt-4 text-[0.95rem] leading-[1.9] text-ink-muted">
        Please seek professional help. The following are resources you can reach out to:
      </p>
      <ul class="mt-5 space-y-3">
        {
          helps.map((h) => (
            <li class="hairline flex items-baseline justify-between rounded-xl border px-5 py-3.5">
              <span class="text-ink">{h.name}</span>
              <span class="font-display text-[1.1rem] text-lamp-deep">{h.contact}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- One-line privacy link -->
    <p class="mt-16 text-[0.95rem] text-ink-muted">
      For the full picture on data and privacy, see
      <a class="link-quiet" href="/en/privacy">Privacy →</a>
    </p>

    <p class="mt-12 border-l-2 border-lamp/60 pl-6 text-lede text-ink">
      Only upload records you have the right to use.
    </p>
  </main>
  <Footer locale={locale} />
</Base>
