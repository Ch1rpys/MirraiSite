---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import DeskSheet from '../../../components/room/DeskSheet.astro';

const locale = 'en' as const;
const posts = (await getCollection('blogEn')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<Base
  locale={locale}
  title="Release blog · Mirrai"
  description="Mirrai release blog: readable changelogs — what shipped in each version, and why."
>
  <Header locale={locale} />
  <main>
    <DeskSheet>
      <div class="text-[0.8rem] tracking-[0.22em] text-lamp-deep">Release blog</div>
      <h1 class="mt-4 text-headline text-ink">Every version, with the why.</h1>
      <p class="mt-6 text-lede text-ink-muted">
        A readable changelog at every release — not a commit list, but notes written for people.
      </p>

      <div class="mt-12 space-y-4">
        {
          posts.map((post) => (
            <a
              href={`/en/blog/${post.id}`}
              class="hairline block rounded-2xl border bg-surface/40 px-6 py-6 transition-colors hover:border-lamp-deep"
            >
              <div class="text-[0.8rem] tracking-[0.12em] text-ink-muted">
                {post.data.pubDate.toISOString().slice(0, 10)}
              </div>
              <h2 class="mt-2 text-[1.25rem] font-medium text-ink">{post.data.title}</h2>
              <p class="mt-2.5 text-[0.95rem] leading-[1.85] text-ink-muted">{post.data.description}</p>
            </a>
          ))
        }
        {
          posts.length === 0 && (
            <p class="text-ink-muted">No release posts yet. The first one ships with the next release.</p>
          )
        }
      </div>
    </DeskSheet>
  </main>
  <Footer locale={locale} edge />
</Base>
