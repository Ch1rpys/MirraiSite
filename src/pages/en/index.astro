---
import Base from '../../layouts/Base.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Hero from '../../components/home/Hero.astro';
import Unfinished from '../../components/home/Unfinished.astro';
import HowItWorks from '../../components/home/HowItWorks.astro';
import WhenAbsent from '../../components/home/WhenAbsent.astro';
import Graduation from '../../components/home/Graduation.astro';
import Fidelity from '../../components/home/Fidelity.astro';
import Trust from '../../components/home/Trust.astro';
import DownloadSection from '../../components/home/Download.astro';
import Coda from '../../components/home/Coda.astro';
import { useDict } from '../../i18n';

const locale = 'en' as const;
const t = useDict(locale);
---

<Base locale={locale} title={`Mirrai · ${t.site.tagline}`} description={t.site.description}>
  <Header locale={locale} />
  <main>
    <Hero locale={locale} />
    <Unfinished locale={locale} />
    <HowItWorks locale={locale} />
    <WhenAbsent locale={locale} />
    <Graduation locale={locale} />
    <Fidelity locale={locale} />
    <Trust locale={locale} />
    <DownloadSection locale={locale} />
    <Coda locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
