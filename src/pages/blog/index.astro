---
/**
 * 博客列表页（M3.2）
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

const locale = 'zh' as const;
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Base
  locale={locale}
  title="版本博客 · Mirrai"
  description="Mirrai 版本博客：可读化的 changelog，每一版写了什么、为什么这么写。"
>
  <Header locale={locale} />
  <main class="mx-auto max-w-3xl px-5 pb-24 pt-16 md:px-8 md:pt-24">
    <div class="text-[0.8rem] tracking-[0.22em] text-lamp-deep">版本博客</div>
    <h1 class="mt-4 text-headline text-ink">每一版，写清楚为什么。</h1>
    <p class="mt-6 text-lede text-ink-muted">
      发版时一篇可读 changelog——不是 commit 列表，是人写给人看的更新说明。
    </p>

    <div class="mt-12 space-y-4">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="hairline block rounded-2xl border bg-surface/40 px-6 py-6 transition-colors hover:border-lamp-deep"
          >
            <div class="text-[0.8rem] tracking-[0.12em] text-ink-muted">
              {post.data.pubDate.toISOString().slice(0, 10)}
            </div>
            <h2 class="mt-2 text-[1.25rem] font-medium text-ink">{post.data.title}</h2>
            <p class="mt-2.5 text-[0.95rem] leading-[1.85] text-ink-muted">{post.data.description}</p>
          </a>
        ))
      }
      {
        posts.length === 0 && (
          <p class="text-ink-muted">还没有发版文。第一篇会在下一次产品发版后上线。</p>
        )
      }
    </div>
  </main>
  <Footer locale={locale} />
</Base>
