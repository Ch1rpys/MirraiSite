---
import { getCollection, render } from 'astro:content';
import DocsLayout, { type DocItem } from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);

const all = await getCollection('docs');
const items: DocItem[] = all.map((d) => ({
  id: d.id,
  title: d.data.title,
  order: d.data.order,
  section: d.id.split('/')[0] ?? '',
}));

// FAQ 页：从正文抽取 ## 问答对，输出 FAQPage 结构化数据
const faqItems =
  doc.id === 'faq'
    ? (() => {
        const body = doc.body ?? '';
        const parts = body.split(/^## /m).slice(1);
        return parts
          .map((part) => {
            const nl = part.indexOf('\n');
            const q = (nl === -1 ? part : part.slice(0, nl)).replace(/\*\*/g, '').trim();
            const a = (nl === -1 ? '' : part.slice(nl))
              .replace(/```[\s\S]*?```/g, '')
              .replace(/^###? /gm, '')
              .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
              .replace(/[*`>#]/g, '')
              .trim()
              .split('\n')
              .filter(Boolean)
              .slice(0, 2)
              .join(' ')
              .slice(0, 300);
            return q && a ? { q, a } : null;
          })
          .filter((x): x is { q: string; a: string } => x !== null);
      })()
    : [];

const SECTION_LABELS: Record<string, string> = {
  install: '安装',
  usage: '使用',
  channels: '渠道',
  llm: 'LLM 配置',
  faq: '常见问题',
  dev: '开发者',
};
const labeled = items.map((i) => ({ ...i, section: SECTION_LABELS[i.section] ?? i.section }));
---

<DocsLayout
  locale="zh"
  title={doc.data.title}
  description={doc.data.description ?? ''}
  items={labeled}
  currentId={doc.id}
  headings={headings}
  faq={faqItems}
>
  <h1 class="!text-[2.1rem] !leading-tight !text-ink">{doc.data.title}</h1>
  <Content />
</DocsLayout>
