---
/**
 * /ethics —— 伦理与边界（M2.2）
 * 五个「不是什么」一条不少；隐私内容不展开，只链接 /privacy。
 */
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import DeskSheet from '../components/room/DeskSheet.astro';
import ShotSlot from '../components/layout/ShotSlot.astro';

const locale = 'zh' as const;

const nots = [
  {
    title: '不是替代品',
    body: 'Mirrai 不是真实关系的替代品。它是一个帮你「说完没说完的话」的空间——不是让你永远留在这里。毕业机制的存在，就是为了让这段体验有终点。',
  },
  {
    title: '不是挽回工具',
    body: '它不是教你复合的。它不做关系咨询，不给「怎么让她回来」的建议。它只做一件事：把没说完的话，继续说完。',
  },
  {
    title: '同意权前置',
    body: '对真实人物的人格建模，应事先获得对方同意。仅上传你有权使用的聊天记录。如果对方没有同意，请不要用 TA 的记录创建分身。',
  },
  {
    title: '专业帮助边界',
    body: 'Mirrai 不能替代专业心理咨询。如果你正在经历严重的情绪困扰，请寻求专业帮助（求助资源见下）。它是镜子，不是医生。',
  },
  {
    title: 'AI 身份透明',
    body: '这是模拟，不是 TA 本人。默认配置下，分身在被认真询问时会承认自己是 AI（可在设置中调整）。我们把这句话放在最显眼的地方，不藏在条款里。',
  },
];

const layers = [
  {
    title: '数据本地',
    body: '上传素材保存在你自己的机器上（./uploads/）。从上传到蒸馏到对话，不经过任何第三方服务器。配合 Ollama 可实现完全离线推理。',
  },
  {
    title: '记忆锚点防幻觉',
    body: '每一轮回复都标注召回了哪几条记忆。它说起的三个月前的事，是翻出来的，不是编出来的。记忆与生成分离，可追溯、可审计。',
  },
  {
    title: '情感安全层',
    body: '内置危机识别、使用强度与依赖趋势监测。它不分析你、不上传你，它只在你身边越走越深的时候提醒你一次。',
  },
  {
    title: '毕业「只建议一次」',
    body: '毕业机制默认只给建议：提过一次之后进入冷静期，冷静期过了才会再提。拒绝不是一扇关上的门——你随时可以改主意。你可以把它设为「仅手动」或「关闭」，最终决定权在你手里。',
  },
  {
    title: '开源可审计',
    body: 'MIT 许可。蒸馏、记忆、情感状态、回应——每一层代码都可以自己看、自己改。我们不请你信任我们，我们请你审计我们。',
  },
];

const helps = [
  { name: '全国心理援助热线', contact: '12356' },
  { name: '北京心理危机研究与干预中心', contact: '010-8295 1332' },
  { name: '希望24热线', contact: '400-161-9995' },
];
---

<Base
  locale={locale}
  title="伦理与边界 · Mirrai"
  description="Mirrai 不是替代品、不是挽回工具、同意权前置、不能替代专业帮助、AI 身份透明。数据本地、记忆锚点防幻觉、情感安全层、毕业只建议一次、开源可审计。"
>
  <Header locale={locale} />
  <main>
    <DeskSheet>
      <div class="text-[0.8rem] tracking-[0.22em] text-lamp-deep">伦理与边界</div>
      <h1 class="mt-4 text-headline text-ink">这个产品处理的是真实的人和真实的感情。</h1>
      <p class="mt-6 text-lede text-ink-muted">
        请在使用前阅读。以下五条不是免责声明——是产品的设计前提。
      </p>

      <!-- 五个「不是什么」 -->
      <section class="mt-14 space-y-10">
        {
          nots.map((n, i) => (
            <article>
              <div class="flex items-baseline gap-4">
                <span class="font-display text-[1.6rem] text-lamp/85">{String(i + 1).padStart(2, '0')}</span>
                <h2 class="text-[1.25rem] font-medium text-ink">{n.title}</h2>
              </div>
              <p class="prose-garamond mt-3 text-ink-muted">{n.body}</p>
            </article>
          ))
        }
      </section>

      <!-- 五层机制 -->
      <section class="mt-16">
        <h2 class="text-[1.35rem] font-medium text-ink">还有五件事，我们做在了里面</h2>
        <div class="mt-8 space-y-8">
          {
            layers.map((l) => (
              <div class="hairline rounded-2xl border bg-surface/40 px-6 py-6">
                <h3 class="text-[1.05rem] font-medium text-ink">{l.title}</h3>
                <p class="mt-2.5 text-[0.95rem] leading-[1.9] text-ink-muted">{l.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 本地求助资源 -->
      <section class="mt-16">
        <h2 class="text-[1.35rem] font-medium text-ink">如果你正在经历严重的情绪困扰</h2>
        <p class="mt-4 text-[0.95rem] leading-[1.9] text-ink-muted">
          请寻求专业心理咨询。以下是可拨打的本地求助资源：
        </p>
        <ul class="mt-5 space-y-3">
          {
            helps.map((h) => (
              <li class="hairline flex items-baseline justify-between rounded-xl border px-5 py-3.5">
                <span class="text-ink">{h.name}</span>
                <span class="font-display text-[1.1rem] text-lamp-deep">{h.contact}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <ShotSlot id="P8" scene="设置 · 隐私 / 毕业模式" locale={locale} tilt={-2} tape class="mx-auto mt-16 w-[min(100%,22rem)]" />

      <!-- 隐私一句链接 -->
      <p class="mt-16 text-[0.95rem] text-ink-muted">
        关于数据与隐私的完整说明，请见
        <a class="link-quiet" href="/privacy">隐私说明 →</a>
      </p>

      <p class="mt-12 border-l-2 border-lamp/60 pl-6 text-lede text-ink">
        仅上传你有权使用的记录。
      </p>
    </DeskSheet>
  </main>
  <Footer locale={locale} edge />
</Base>
