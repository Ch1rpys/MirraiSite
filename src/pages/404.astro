---
/**
 * 404 —— 符合调性（M2.6）：「这句话没有发出去」
 */
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const locale = 'zh' as const;
---

<Base
  locale={locale}
  title="这句话没有发出去 · Mirrai"
  description="页面不存在。"
  noindex={true}
>
  <Header locale={locale} />
  <main class="mx-auto flex min-h-[60vh] max-w-3xl flex-col justify-center px-5 py-24 md:px-8">
    <div class="text-[0.8rem] tracking-[0.22em] text-lamp-deep">404</div>
    <h1 class="mt-5 text-display text-ink">这句话没有发出去。</h1>
    <p class="mt-7 max-w-xl text-lede text-ink-muted">
      你要找的页面不在这里——像一条没送到的消息。回到首页，或者去 GitHub 找我们。
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/"
        class="rounded-full bg-lamp px-7 py-3.5 text-[0.95rem] font-medium text-bg transition-opacity hover:opacity-88"
      >
        回到首页
      </a>
      <a
        href="/download"
        class="hairline rounded-full border px-7 py-3.5 text-[0.95rem] text-ink transition-colors hover:border-lamp-deep hover:text-lamp-deep"
      >
        下载 Mirrai
      </a>
    </div>
  </main>
  <Footer locale={locale} />
</Base>
