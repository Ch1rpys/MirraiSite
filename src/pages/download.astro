---
/**
 * /download —— 三平台 + Docker 四入口（M2.1）
 * 计数口径：macOS/Windows/Docker 按钮走 /go/*；源码与 Release notes 直链不计。
 * SHA 仅安装包文件展示；Docker 显示镜像 digest 或不显示。
 */
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import releasesData from '../data/releases.json';
import { getCollection } from 'astro:content';
import { REPO, GO_LINKS, SITE } from '../consts';

const locale = 'zh' as const;
const releases = releasesData.releases ?? [];
const blogPosts = await getCollection('blog');
const blogFor = (tag: string) => {
  const id = 'v' + tag.replace(/^v/, '').replace(/\./g, '-');
  return blogPosts.find((p) => p.id === id);
};
const latest = releases[0];

const platforms = [
  {
    key: 'macos',
    icon: '⌘',
    name: 'macOS',
    req: 'Apple Silicon · macOS 13+',
    href: '/go/macos',
    file: 'Mirrai-macOS-arm64.dmg',
    counted: true,
  },
  {
    key: 'windows',
    icon: '⊞',
    name: 'Windows',
    req: 'Windows x64',
    href: '/go/windows',
    file: 'Mirrai-Setup-x64.exe',
    counted: true,
  },
  {
    key: 'docker',
    icon: '⬢',
    name: 'Docker',
    req: 'Docker · docker compose',
    href: '/go/docker',
    file: null,
    counted: true,
  },
  {
    key: 'source',
    icon: '</>',
    name: '源码',
    req: 'Node 24+ · PostgreSQL 14+',
    href: REPO.url,
    file: null,
    counted: false,
  },
];

const fmtSize = (bytes: number) =>
  bytes > 1024 * 1024 ? `${(bytes / 1024 / 1024).toFixed(1)} MB` : `${Math.round(bytes / 1024)} KB`;
---

<Base
  locale={locale}
  title="下载 Mirrai · macOS / Windows / Docker"
  description="下载 Mirrai——开源情感记忆操作系统。macOS 一键安装、Windows Setup、Docker 一键部署、源码运行。数据不出本地。"
>
  <Header locale={locale} />
  <main class="mx-auto max-w-6xl px-5 pb-24 pt-16 md:px-8 md:pt-24">
    <div class="text-[0.8rem] tracking-[0.22em] text-lamp-deep">下载</div>
    <h1 class="mt-4 max-w-2xl text-headline text-ink">装上它，开始一段认真的告别。</h1>
    <p class="mt-6 max-w-2xl text-lede text-ink-muted">
      {
        latest
          ? `当前版本 ${latest.version} · ${latest.publishedAt.slice(0, 10)}`
          : '版本信息暂不可用，请前往 GitHub Releases。'
      }
    </p>

    <!-- 四入口卡片 -->
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        platforms.map((p) => (
          <a
            href={p.href}
            class="hairline group rounded-2xl border bg-surface/50 px-6 py-8 transition-colors hover:border-lamp-deep"
            {...(p.counted ? {} : { target: '_blank', rel: 'noopener' })}
          >
            <div class="text-[1.35rem] text-lamp" aria-hidden="true">
              {p.icon}
            </div>
            <div class="mt-4 text-[1.05rem] font-medium text-ink">{p.name}</div>
            <div class="mt-1.5 text-[0.82rem] text-ink-muted">{p.req}</div>
            {p.file && latest && (
              <div class="mt-3 text-[0.78rem] text-ink-muted/80">
                {p.file}
                {(() => {
                  const asset = latest.assets.find((a) => a.name === p.file);
                  return asset ? ` · ${fmtSize(asset.size)}` : '';
                })()}
              </div>
            )}
            <div class="mt-4 text-[0.85rem] text-ink transition-colors group-hover:text-lamp-deep">
              {p.key === 'source' ? '查看仓库 →' : '下载 →'}
            </div>
          </a>
        ))
      }
    </div>

    <p class="mt-8 text-[0.85rem] text-ink-muted">
      Apple Silicon / macOS 13+ · Windows x64 · Docker · Node 24+（源码）
    </p>
    <p class="mt-2 text-[0.78rem] text-ink-muted/80">仅上传你有权使用的记录。</p>

    <!-- SHA 校验和（仅安装包） -->
    {
      latest && (
        <section class="mt-16">
          <h2 class="text-[1.15rem] font-medium text-ink">校验和（SHA-256）</h2>
          <p class="mt-2 text-[0.85rem] text-ink-muted">
            校验和仅适用于安装包文件。Docker 镜像请核对镜像 digest。
          </p>
          <div class="hairline mt-5 overflow-hidden rounded-xl border">
            <table class="w-full text-left text-[0.85rem]">
              <thead>
                <tr class="hairline border-b text-ink-muted">
                  <th class="px-4 py-3 font-normal">文件</th>
                  <th class="px-4 py-3 font-normal">SHA-256</th>
                </tr>
              </thead>
              <tbody>
                {latest.assets
                  .filter((a) => /\.(dmg|exe)$/i.test(a.name))
                  .map((a) => (
                    <tr class="hairline border-b last:border-b-0">
                      <td class="px-4 py-3 text-ink">{a.name}</td>
                      <td class="px-4 py-3 text-ink-muted">
                        <span class="block break-all text-[0.78rem]">
                          见 Release 附带的 SHA256SUMS 文件
                        </span>
                      </td>
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>
          <p class="mt-3 text-[0.8rem] text-ink-muted">
            <a class="link-quiet" href={`${latest.htmlUrl}`} target="_blank" rel="noopener">
              查看 {latest.version} 的 SHA256SUMS 与完整说明 →
            </a>
          </p>
        </section>
      )
    }

    <!-- Release notes（可读化） -->
    {
      latest && (
        <section class="mt-16">
          <h2 class="text-[1.15rem] font-medium text-ink">更新说明 · {latest.version}</h2>
          <article class="prose-garamond hairline mt-5 rounded-2xl border bg-surface/40 px-6 py-8 text-ink-muted md:px-8">
            <p class="text-[0.95rem]">
              {latest.body.split('\n').find((l) => l.trim() && !l.startsWith('#') && !l.startsWith('>')) ??
                '详细说明见 GitHub Release。'}
            </p>
            <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
              {
                blogFor(latest.version) && (
                  <a class="link-quiet text-[0.95rem]" href={`/blog/${blogFor(latest.version)!.id}`}>
                    阅读完整 Release notes →
                  </a>
                )
              }
              <a class="link-quiet text-[0.95rem]" href={latest.htmlUrl} target="_blank" rel="noopener">
                在 GitHub 查看 →
              </a>
            </p>
          </article>
        </section>
      )
    }

    <!-- 版本历史 -->
    <section class="mt-16">
      <h2 class="text-[1.15rem] font-medium text-ink">版本历史</h2>
      <ul class="mt-5 space-y-3">
        {
          releases.map((r) => (
            <li class="hairline flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 rounded-xl border px-5 py-4">
              <a href={r.htmlUrl} target="_blank" rel="noopener" class="text-ink hover:text-lamp-deep">
                {r.version}
              </a>
              <span class="text-[0.82rem] text-ink-muted">{r.publishedAt.slice(0, 10)}</span>
              <a href={r.htmlUrl} target="_blank" rel="noopener" class="link-quiet text-[0.82rem]">
                Release notes
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer locale={locale} />
</Base>
